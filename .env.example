# ===========================================================================
# Grras LMS — example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in local values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets, keys, tokens or passwords.
# Staging/production values are injected by the deployment platform's secret
# manager, not by this file. See docs/environments.md and docs/security.md.
# ===========================================================================

# --- Environment selection -------------------------------------------------
# DJANGO_ENV must match the settings module below, or the app refuses to boot.
# One of: local | development | staging | production | test
DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Core Django -----------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Required in every environment except local/test (which have a dev-only default).
DJANGO_SECRET_KEY=
# DEBUG is forced off in staging/production regardless of this value.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
# json for machine-readable logs, console for human-readable
DJANGO_LOG_FORMAT=console

# --- Database (PostgreSQL) -------------------------------------------------
# SQLite is rejected outside the test environment.
POSTGRES_DB=grras_lms
POSTGRES_USER=grras
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://grras:change-me-locally@db:5432/grras_lms
# Persistent connection lifetime in seconds (0 disables connection reuse).
# Local development forces 0: `runserver` uses an unbounded thread pool, and
# one held connection per thread exhausts PostgreSQL under load. Deployed
# environments keep 60 because gunicorn's worker count bounds the total.
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False

# --- Cache / rate limiting -------------------------------------------------
# Required in staging/production: throttling needs a counter store shared across
# workers, and an in-process cache silently gives each worker its own limit.
# Locally, `make up` starts Redis too, so the default below just works. Leave it
# empty only if you deliberately want the in-memory cache.
CACHE_URL=redis://redis:6379/0

# --- CORS / CSRF -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Cookies / TLS ---------------------------------------------------------
# Forced secure in staging/production.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=43200
SECURE_HSTS_SECONDS=31536000

# --- API -------------------------------------------------------------------
API_DOCS_ENABLED=True
THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=600/min
THROTTLE_RATE_AUTH=10/min
# End-to-end runs sign in many times from one address; raise this only in a
# throwaway test environment, never in staging or production.
# THROTTLE_RATE_AUTH=500/min

# --- Email -----------------------------------------------------------------
# Password reset and email verification links are sent from here. Local
# development prints mail to the console; deployed environments must use SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@grras.local
# Where emailed links point. Must be the frontend URL the user's browser opens.
FRONTEND_BASE_URL=http://localhost:3000
AUTH_TOKEN_RESET_TTL_HOURS=1
AUTH_TOKEN_VERIFICATION_TTL_DAYS=3

# --- Error reporting (optional) --------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Frontend --------------------------------------------------------------
# Browser-visible: must be the URL the browser can reach.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
# Server-side (container-to-container) API URL used by Next.js server code.
INTERNAL_API_BASE_URL=http://backend:8000

# --- Host port mapping (docker compose) ------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5432

# --- Staging seed data -----------------------------------------------------
# Password for the generated fake demo accounts. Staging-only. Supply via the
# secret manager or a local untracked .env — never commit a real value.
DEMO_USER_PASSWORD=

# --- Background work (Celery) ----------------------------------------------
# Defaults to CACHE_URL when unset. A separate Redis database keeps a cache
# flush from taking the queue with it.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_CONCURRENCY=2
# How often the email outbox is swept for messages due another attempt.
EMAIL_RETRY_INTERVAL_SECONDS=300

# --- File storage -----------------------------------------------------------
# local | s3. Student files must be on s3 in any deployed environment: a
# container volume dies with the container.
FILE_STORAGE_BACKEND=local
# Required when FILE_STORAGE_BACKEND=s3. Credentials are read by boto3 from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the instance role — never commit
# them, and prefer the instance role.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Set only when using a non-AWS S3 (MinIO, Cloudflare R2).
AWS_S3_ENDPOINT_URL=
# Lifetime of a signed object URL, in seconds.
AWS_QUERYSTRING_EXPIRE=300

# --- Upload scanning --------------------------------------------------------
# disabled until a scanner is provisioned. When one is, an unreachable scanner
# refuses the upload rather than waving it through; set UPLOAD_SCAN_FAIL_OPEN
# only with a deliberate reason.
UPLOAD_SCANNER=disabled
UPLOAD_SCAN_FAIL_OPEN=false
