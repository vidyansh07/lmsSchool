# TLS termination for the local staging stack.
#
# Staging exists to behave like production, and production speaks https. That is
# not decoration: `config.settings.hardened` sets SESSION_COOKIE_SECURE and
# CSRF_COOKIE_SECURE unconditionally, so a browser on plain http silently
# refuses to store the session — sign-in appears to succeed and the next request
# is anonymous. The choice is a real certificate or a weakened setting, and
# weakening the setting would mean staging no longer tests what production runs.
#
# Caddy issues its own certificate (`tls internal`). Browsers do not trust that
# authority, so a human clicks through the warning once and Playwright is told
# to ignore it — the certificate is not what is under test.
#
# The site address is `SITE_ADDRESS` from the environment, so the same file
# serves a laptop (`https://localhost:8443`, the default) and a server
# (`https://ec2-….amazonaws.com:8443`) without being edited on the server —
# which is how the deployed copy ended up as a permanently dirty file.
# `amazonaws.com` hostnames are refused by Let's Encrypt, so a public
# certificate needs a real domain (or `<ip>.sslip.io`) and ports 80/443 open;
# until then `tls internal` is what a server gets too.

{
	# No public ACME: this certificate never leaves the machine.
	auto_https disable_redirects
	admin off
}

{$SITE_ADDRESS:https://localhost:8443} {
	tls internal
	encode gzip

	# The API and the app share an origin here, which is also how a real
	# deployment is usually arranged: one hostname, one cookie, no CORS.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle /admin/django/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
