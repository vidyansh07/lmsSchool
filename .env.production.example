# ===========================================================================
# Production environment template — §15.8.
#
# Copy nothing from this file into a repository. Every value below marked
# REQUIRED must come from the platform's secret manager at deploy time; this
# file exists to say *what* must be supplied and why, not to hold it.
#
# The application refuses to start if a required value is missing. That is
# deliberate: a process that boots with a missing secret and degrades quietly is
# harder to diagnose than one that will not boot.
# ===========================================================================

DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production

# REQUIRED. Unique to production — never shared with staging, never rotated
# into a repository. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# REQUIRED. The hostnames the API answers on. Not a wildcard.
DJANGO_ALLOWED_HOSTS=api.lms.example
# REQUIRED. Where the browser application is served from. Both are exact
# origins including the scheme; a mismatch shows up as a CSRF failure that looks
# like a bug in the login form.
CSRF_TRUSTED_ORIGINS=https://lms.example
CORS_ALLOWED_ORIGINS=https://lms.example
FRONTEND_BASE_URL=https://lms.example

# --- Database ---------------------------------------------------------------
# REQUIRED. Point this at the *application* role from
# infra/db/least-privilege.sql — the one that can read and write rows and
# cannot change the schema. Migrations run separately, as grras_migrate.
DATABASE_URL=postgres://grras_app:REQUIRED@db.internal:5432/grras_lms
DATABASE_SSL_MODE=require
# Connections are reused for this many seconds. 0 opens a new one per request.
CONN_MAX_AGE=60

# --- Cache and queue --------------------------------------------------------
# REQUIRED. Separate Redis databases: a cache flush must not empty the queue.
CACHE_URL=redis://cache.internal:6379/0
CELERY_BROKER_URL=redis://cache.internal:6379/1
CELERY_CONCURRENCY=4
EMAIL_RETRY_INTERVAL_SECONDS=300
# Must stay false. True runs queued work inside the HTTP request, which is the
# failure the queue exists to prevent; the settings refuse it anyway.
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage ---------------------------------------------------------
# REQUIRED. Student files must not live on a container volume: it dies with the
# container. The bucket must have no public read policy — the application refuses
# to boot with a public ACL configured.
FILE_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Leave empty on AWS. Set only for an S3-compatible provider.
AWS_S3_ENDPOINT_URL=
# Prefer an instance role and leave these unset. If they must be supplied, they
# come from the secret manager and are rotated on a schedule.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signed object URLs expire after this many seconds.
AWS_QUERYSTRING_EXPIRE=300

# --- Mail -------------------------------------------------------------------
# REQUIRED. Without mail nobody can reset a password, so the application will
# not start with the SMTP backend and no host.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@lms.example

# --- Transport --------------------------------------------------------------
# TLS terminates at the ingress, which is also what sets X-Forwarded-Proto.
# NUM_PROXIES must match the real topology: too high and a client can spoof its
# own address, defeating rate limiting and audit attribution.
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True
# Two years, with subdomains and preload. Start lower on a new domain: HSTS
# cannot be withdrawn quickly, and a wrong value locks browsers out of it.
SECURE_HSTS_SECONDS=63072000

# --- Uploads ----------------------------------------------------------------
# Set to a configured scanner once one exists. An unreachable scanner refuses
# the upload; only set UPLOAD_SCAN_FAIL_OPEN=true with a written reason.
UPLOAD_SCANNER=disabled
UPLOAD_SCAN_FAIL_OPEN=false

# --- Observability ----------------------------------------------------------
DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
APP_VERSION=

# API documentation is off in production: it describes every endpoint and its
# shape to anyone who asks.
API_DOCS_ENABLED=False

# --- Never set in production -------------------------------------------------
# DEBUG is not configurable here; production settings hard-code it off.
# ALLOW_DEMO_SEED is false in production and the seed commands refuse to run.
# DEMO_USER_PASSWORD has no meaning here and must not be set.
