# ===========================================================================
# Staging environment template.
#
# Copy to `.env.staging` (git-ignored) or, preferably, load these values from
# the deployment platform's secret manager. Every secret below MUST be unique
# to staging: reusing a production secret defeats the isolation this file
# exists to provide.
# ===========================================================================

DJANGO_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.staging

# Unique per environment. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=staging-api.grras.example
CSRF_TRUSTED_ORIGINS=https://staging.grras.example
CORS_ALLOWED_ORIGINS=https://staging.grras.example

# Staging database — separate server or at minimum a separate database and
# roles. POSTGRES_USER is bootstrap-only. Web and Celery use APP_DATABASE_USER;
# only the one-shot migration service uses MIGRATION_DATABASE_USER.
POSTGRES_DB=grras_lms_staging
POSTGRES_USER=grras_bootstrap
POSTGRES_PASSWORD=
APP_DATABASE_USER=grras_app
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_USER=grras_migrate
MIGRATION_DATABASE_PASSWORD=
DATABASE_URL=postgres://grras_app:CHANGE_ME@db:5432/grras_lms_staging
MIGRATION_DATABASE_URL=postgres://grras_migrate:CHANGE_ME@db:5432/grras_lms_staging
DATABASE_SSL_MODE=disable

# Shared cache is mandatory: rate limiting must be correct across workers.
CACHE_URL=redis://redis:6379/0

DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO
API_DOCS_ENABLED=True
# The proxy. On a laptop the defaults are right. On a server, PROXY_BIND=0.0.0.0
# publishes it, and SITE_ADDRESS is the one origin the stack answers on — the
# same value the origin settings above and NEXT_PUBLIC_API_BASE_URL use.
PROXY_BIND=127.0.0.1
PROXY_PORT=8443
SITE_ADDRESS=https://localhost:8443
NUM_PROXIES=1

# TLS terminates at the ingress; the app trusts X-Forwarded-Proto from it.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Mail. A deployed environment refuses console, memory, dummy and file
# backends because they expose credential links to operators or make account
# verification impossible. Use the non-delivering local stack for showcase
# seeding; staging is for the two approved test accounts and synthetic data.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@staging.grras.example
FRONTEND_BASE_URL=https://staging.grras.example

# Unique per environment. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

SENTRY_DSN=
APP_VERSION=0.1.0

# Off-host, encrypted backups. Use a staging-only bucket with Block Public
# Access, versioning/Object Lock as required by retention policy, and a KMS key
# whose decrypt permission is limited to the restore role. Backups remain
# local only when the bucket is blank, which is not sufficient before cleanup.
BACKUP_S3_BUCKET=
BACKUP_KMS_KEY_ID=
BACKUP_KEEP_DAYS=14

NEXT_PUBLIC_API_BASE_URL=https://staging-api.grras.example
NEXT_PUBLIC_APP_ENV=staging

BACKEND_PORT=8001
FRONTEND_PORT=3001

# Optional password for the reserved-domain fake accounts created by
# `manage.py seed_demo_data`. Staging-only, rotated freely, and never committed.
# The real-domain showcase seeder refuses this delivering SMTP configuration;
# do not bypass that guard on the secure user-acceptance staging environment.
DEMO_USER_PASSWORD=

# Domains scripts/verify_demo.sh accepts in addition to reserved TLDs. The two
# approved staging administrators use this domain; every other staged learner,
# trainer and business record must remain synthetic. Domain allow-listing does
# not make imported records safe—review the exact account list before release.
VERIFY_ALLOWED_EMAIL_DOMAINS=grrassolutions.in

# --- Background work (Celery) ----------------------------------------------
# Defaults to CACHE_URL when unset. A separate Redis database keeps a cache
# flush from taking the queue with it.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_CONCURRENCY=2
# How often the email outbox is swept for messages due another attempt.
EMAIL_RETRY_INTERVAL_SECONDS=300

# --- File storage -----------------------------------------------------------
# local | s3. Student files must be on s3 in any deployed environment: a
# container volume dies with the container.
FILE_STORAGE_BACKEND=s3
# Required when FILE_STORAGE_BACKEND=s3. Credentials are read by boto3 from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the instance role — never commit
# them, and prefer the instance role.
AWS_STORAGE_BUCKET_NAME=grras-lms-staging
AWS_S3_REGION_NAME=us-east-1
# Set only when using a non-AWS S3. The staging stack runs MinIO, which speaks
# the same protocol; point this at a real endpoint (or leave it empty for AWS)
# and nothing else changes.
AWS_S3_ENDPOINT_URL=http://storage:9000
# Credentials for that endpoint. On AWS, prefer an instance role and leave these
# unset. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Lifetime of a signed object URL, in seconds.
AWS_QUERYSTRING_EXPIRE=300

# --- Upload scanning --------------------------------------------------------
# The private ClamAV service in docker-compose.staging.yml. An unreachable
# scanner refuses the upload, and hardened settings reject fail-open mode.
UPLOAD_SCANNER=clamav
UPLOAD_SCAN_FAIL_OPEN=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
