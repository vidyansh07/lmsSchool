# ===========================================================================
# Staging environment template.
#
# Copy to `.env.staging` (git-ignored) or, preferably, load these values from
# the deployment platform's secret manager. Every secret below MUST be unique
# to staging: reusing a production secret defeats the isolation this file
# exists to provide.
# ===========================================================================

DJANGO_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.staging

# Unique per environment. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=staging-api.grras.example
CSRF_TRUSTED_ORIGINS=https://staging.grras.example
CORS_ALLOWED_ORIGINS=https://staging.grras.example

# Staging database — separate server or at minimum a separate database and role.
POSTGRES_DB=grras_lms_staging
POSTGRES_USER=grras_staging
POSTGRES_PASSWORD=
DATABASE_URL=postgres://grras_staging:CHANGE_ME@db:5432/grras_lms_staging
DATABASE_SSL_MODE=disable

# Shared cache is mandatory: rate limiting must be correct across workers.
CACHE_URL=redis://redis:6379/0

DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO
API_DOCS_ENABLED=True
NUM_PROXIES=1

# TLS terminates at the ingress; the app trusts X-Forwarded-Proto from it.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Mail is required in a deployed environment: without it nobody can reset a
# password. The app refuses to start if EMAIL_HOST is unset with the SMTP backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@staging.grras.example
FRONTEND_BASE_URL=https://staging.grras.example

SENTRY_DSN=
APP_VERSION=0.1.0

NEXT_PUBLIC_API_BASE_URL=https://staging-api.grras.example
NEXT_PUBLIC_APP_ENV=staging

BACKEND_PORT=8001
FRONTEND_PORT=3001

# Password for the fake demo accounts created by `manage.py seed_demo_data`.
# Staging-only, rotated freely, and never committed.
DEMO_USER_PASSWORD=

# --- Background work (Celery) ----------------------------------------------
# Defaults to CACHE_URL when unset. A separate Redis database keeps a cache
# flush from taking the queue with it.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_CONCURRENCY=2
# How often the email outbox is swept for messages due another attempt.
EMAIL_RETRY_INTERVAL_SECONDS=300

# --- File storage -----------------------------------------------------------
# local | s3. Student files must be on s3 in any deployed environment: a
# container volume dies with the container.
FILE_STORAGE_BACKEND=s3
# Required when FILE_STORAGE_BACKEND=s3. Credentials are read by boto3 from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the instance role — never commit
# them, and prefer the instance role.
AWS_STORAGE_BUCKET_NAME=grras-lms-staging
AWS_S3_REGION_NAME=us-east-1
# Set only when using a non-AWS S3. The staging stack runs MinIO, which speaks
# the same protocol; point this at a real endpoint (or leave it empty for AWS)
# and nothing else changes.
AWS_S3_ENDPOINT_URL=http://storage:9000
# Credentials for that endpoint. On AWS, prefer an instance role and leave these
# unset. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Lifetime of a signed object URL, in seconds.
AWS_QUERYSTRING_EXPIRE=300

# --- Upload scanning --------------------------------------------------------
# disabled until a scanner is provisioned. When one is, an unreachable scanner
# refuses the upload rather than waving it through; set UPLOAD_SCAN_FAIL_OPEN
# only with a deliberate reason.
UPLOAD_SCANNER=disabled
UPLOAD_SCAN_FAIL_OPEN=false
