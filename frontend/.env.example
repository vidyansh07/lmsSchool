# Frontend environment template. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and
# are therefore PUBLIC. Never put a secret in one.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# Server-side only: used by Next.js server components inside Docker, where the
# backend is reachable by service name rather than on localhost.
INTERNAL_API_BASE_URL=http://backend:8000
